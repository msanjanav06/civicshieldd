PORT=5000
NODE_ENV=development
# Leave MONGODB_URI empty or local; if not reachable, CivicShield automatically launches in-memory Mongo
MONGODB_URI=mongodb://localhost:27017/civicshield
JWT_SECRET=civicshield_production_ready_jwt_secret_key_replace_in_prod
JWT_EXPIRES_IN=7d

# Spatial duplicate detection settings
DUPLICATE_RADIUS_METERS=100
DUPLICATE_HOURS_WINDOW=72

# Storage options: 'local' (default) or 'cloudinary'
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Optional Cloudinary credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
